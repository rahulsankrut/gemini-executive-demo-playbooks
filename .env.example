# Optional password gate (leave blank for open local access)
STORYBOOK_PASSWORD=

# Optional semicolon-separated reviewer dropdown roster: "Jane Doe <jane@example.com>;John Smith <john@example.com>"
STORYBOOK_ROSTER=

# Optional gate banner label
STORYBOOK_GATE_KICKER=🔒 EXECUTIVE WORKSHOP · TEAM REVIEW GATE

# Optional Cloud Storage persistence for Cloud Run deployments
GCS_BUCKET=
GCS_STATE_OBJECT=storybook_feedback_state.json

# Optional deployed Cloud Run URL for fetch_feedback.py
STORYBOOK_CLOUD_RUN_URL=
